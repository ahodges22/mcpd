[Unit]
Description=mcpd, the local MCP proxy daemon
Documentation=https://github.com/ahodges22/mcpd
After=network-online.target
# Tied to the session rather than to the user manager, because the credentials the
# declarations reference exist only once a session has established them. This is what keeps
# the daemon correct on a machine where lingering is enabled for some other service: the user
# manager then starts at boot, and a daemon started there would come up with no tokens and
# fail every bearer-header backend while looking healthy itself.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mcpd
Restart=always
RestartSec=2
# The user environment is imported rather than an EnvironmentFile: backends reference
# credentials the user's session already holds through ${VAR}, and a second copy of those
# in a file under the state directory is one more place a token can leak from.
# PATH is set explicitly because PassEnvironment cannot carry it: systemd always sets a
# default PATH for a service, which wins. The directories are named rather than inherited,
# which is the same principle the least-privilege child environment applies.
Environment=PATH=%h/.local/bin:%h/.bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/bin:/usr/bin:/bin
# The credential variables the declarations reference through ${VAR} have to be named here
# too. Omitting them starts the daemon with no tokens at all, and every backend behind a
# bearer header then fails its handshake while the daemon itself looks healthy. Add whatever
# else a declaration references; a variable that is not set is simply not passed.
PassEnvironment=HOME USER LOGNAME SHELL LANG TZ TERM TMPDIR
PassEnvironment=DD_ACCESS_TOKEN GITHUB_TOKEN LITELLM_KEY N8N_STAGE_MCP_TOKEN
# A stdio backend is a child of this unit. control-group is what reaps one that outlives a
# shutdown whose teardown budget expired, which the daemon deliberately allows rather than
# blocking exit on an unbounded tool call.
KillMode=control-group
TimeoutStopSec=30

[Install]
# Not default.target: that is the user manager's own target, which starts at boot when
# lingering is on. A headless install with no graphical session wants default.target instead,
# and must then either leave lingering off or accept one restart after boot.
WantedBy=graphical-session.target
