<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mcpd.daemon</string>

  <!-- launchd has no PassEnvironment, and a LaunchAgent is handed almost no environment at
       all. Declarations reference credentials through ${VAR}, so the daemon is started
       through a login shell and inherits whatever the profile exports. This is the one real
       difference from the systemd unit, and it is why the exports must be somewhere a
       non-interactive login shell reads: .zprofile rather than .zshrc, whose usual early
       return on a non-interactive shell would skip them silently.

       exec keeps the shell out of the process tree, so KeepAlive watches the daemon itself
       and not a wrapper that has already gone away. The redirection is done here rather than
       with StandardOutPath because launchd does not expand $HOME in a path value, and a
       hardcoded home directory is the sort of thing that is wrong on someone else's machine.
       Nothing rotates this file. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>exec "$HOME/.local/bin/mcpd" >> "$HOME/Library/Logs/mcpd.log" 2>&amp;1</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Unconditional, matching Restart=always: a clean exit is still an exit, and the daemon
       is meant to be there whenever a client might connect. -->
  <key>KeepAlive</key>
  <true/>

  <!-- launchd will not respawn faster than this. The daemon exits non-zero on a declaration
       file it cannot read, and with no floor that becomes a spin. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
